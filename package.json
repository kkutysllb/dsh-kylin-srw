{
  "name": "dsh-kylin-srw",
  "version": "0.0.1",
  "description": "DSH/QiLin 双通道科研工作台：可溯源的读—写—证（双语逐段精读 / 按刊分级论文生产线 / 素材真实性证明链）",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-force-exit tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke-plugin.mjs",
    "smoke:negatives": "node scripts/smoke-plugin.mjs --negatives",
    "test:security": "node --import tsx --test tests/security.test.ts",
    "smoke:dual": "node scripts/smoke-dual-host.mjs",
    "dev:install": "node scripts/dev-install.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-default-model": "*",
    "@deepseek-ai/dsh-agent-presets": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-permission-presets": "*",
    "@deepseek-ai/dsh-schedule": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-workspace": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "kylin",
    "research",
    "scientific-research",
    "bilingual-reading",
    "latex",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/dsh-kylin-srw.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#standard-fonts/*": "./lib/pdfkit-standard-fonts/*.cjs"
  }
}
